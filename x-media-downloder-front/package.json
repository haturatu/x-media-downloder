{
  "name": "x-media-downloader-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --run dev:watch",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && vite build --ssr server.ts --outDir dist/server",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/server/server.js --production",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev:watch": "tsx watch --clear-screen=false server.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "express": "^5.3.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
